{
  "name": "DeepLabV3 ResNet-50",
  "task": "image-segmentation",
  "description": "DeepLabV3 model with a ResNet-50 backbone for semantic segmentation (21 classes).",
  "architecture": "deeplabv3",
  "variant": "resnet50",
  "dataset": "Pascal VOC",
  "format": "tflite",
  "version": "1.0",
  "labels": [
    "background",
    "aeroplane",
    "bicycle",
    "bird",
    "boat",
    "bottle",
    "bus",
    "car",
    "cat",
    "chair",
    "cow",
    "diningtable",
    "dog",
    "horse",
    "motorbike",
    "person",
    "pottedplant",
    "sheep",
    "sofa",
    "train",
    "tvmonitor"
  ],
  "classes_count": 21,
  "input_size": [
    1,
    3,
    256,
    256
  ],
  "input_layout": "nchw",
  "output_format": "segmentation_mask",
  "color_space": "rgb",
  "normalize": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "post_processing": {
    "type": "argmax",
    "default_threshold": 0.5
  },
  "visualization": {
    "type": "mask_overlay",
    "show_labels": true,
    "show_confidence": false
  },
  "parameters": [
    {
      "key": "mask_opacity",
      "label": "Mask Opacity",
      "type": "slider",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1,
      "default": 0.6
    }
  ],
  "supported_modes": [
    "camera",
    "image"
  ]
}