{
  "name": "RTMW WholeBody",
  "task": "pose-estimation",
  "description": "Whole-body 2D pose (133 keypoints: body, face, hands, feet).",
  "architecture": "rtmpose",
  "variant": "rtmw-m",
  "format": "tflite",
  "version": "1.0",
  "input_size": [
    1,
    3,
    256,
    192
  ],
  "input_layout": "nchw",
  "output_format": "rtmpose_simcc",
  "color_space": "rgb",
  "normalize": {
    "mean": [
      123.675,
      116.28,
      103.53
    ],
    "std": [
      58.395,
      57.12,
      57.375
    ],
    "scale": 1.0
  },
  "post_processing": {
    "type": "rtmpose_decode",
    "simcc_split_ratio": 2,
    "num_keypoints": 133
  },
  "visualization": {
    "type": "pose_skeleton",
    "skeleton": []
  },
  "parameters": [
    {
      "key": "keypoint_threshold",
      "label": "Keypoint Threshold",
      "type": "slider",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1,
      "default": 0.3
    }
  ],
  "supported_modes": [
    "camera",
    "image"
  ]
}