{
  "name": "RTMPose Animal",
  "task": "pose-estimation",
  "description": "Animal keypoints detection (17 keypoints).",
  "architecture": "rtmpose",
  "variant": "rtmpose-animal",
  "format": "tflite",
  "version": "1.0",
  "input_size": [
