{
  "name": "YOLOv8n Pose",
  "task": "pose-estimation",
  "description": "YOLOv8 Nano pose estimation model trained on COCO Keypoints dataset. Detects 17 body keypoints per person.",
  "architecture": "yolov8",
  "variant": "nano",
  "dataset": "COCO-Pose",
  "format": "tflite",
  "version": "1.0",
  "labels": [
    "person"
  ],
  "classes_count": 1,
  "input_size": [
    640,
    640
  ],
  "input_layout": "nhwc",
  "output_format": "yolo_v8",
  "color_space": "rgb",
  "normalize": {
    "mean": [
      0,
      0,
      0
    ],
    "std": [
      1,
      1,
      1
    ]
  },
  "post_processing": {
    "type": "nms",
    "num_keypoints": 17,
    "default_threshold": 0.5,
    "default_iou": 0.45,
    "default_max_detections": 20,
    "default_keypoint_threshold": 0.3
  },
  "visualization": {
    "type": "skeleton",
    "skeleton": [
