    ],
    "keypoint_labels": [
      "nose",
      "left_eye",
      "right_eye",
      "left_ear",
      "right_ear",
      "left_shoulder",
      "right_shoulder",
      "left_elbow",
      "right_elbow",
      "left_wrist",
      "right_wrist",
      "left_hip",
      "right_hip",
      "left_knee",
      "right_knee",
      "left_ankle",
      "right_ankle"
    ]
  },
  "parameters": [
    {
      "key": "threshold",
      "label": "Confidence Threshold",
      "type": "slider",
      "min": 0.01,
      "max": 1.0,
      "step": 0.01,
      "default": 0.5
    },
    {
      "key": "iou_threshold",
      "label": "IoU Threshold (NMS)",
      "type": "slider",
      "min": 0.01,
      "max": 1.0,
      "step": 0.01,
      "default": 0.45
    },
    {
      "key": "max_detections",
      "label": "Max Detections",
      "type": "slider",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "key": "keypoint_threshold",
      "label": "Keypoint Confidence",
      "type": "slider",
      "min": 0.01,
      "max": 1.0,
      "step": 0.01,
      "default": 0.3
    }
  ]
}
