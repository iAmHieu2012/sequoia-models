{
  "name": "RTMPose Hand",
  "task": "pose-estimation",
  "description": "Hand keypoints detection (21 keypoints).",
  "architecture": "rtmpose",
  "variant": "rtmpose-hand",
  "format": "tflite",
  "version": "1.0",
  "input_size": [
    1,
    3,
    256,
    256
  ],
  "input_layout": "nchw",
  "output_format": "rtmpose_simcc",
  "color_space": "rgb",
  "normalize": {
    "mean": [
      123.675,
      116.28,
      103.53
    ],
    "std": [
      58.395,
      57.12,
      57.375
    ],
    "scale": 1.0
  },
  "post_processing": {
    "type": "rtmpose_decode",
    "simcc_split_ratio": 2,
    "num_keypoints": 21
  },
  "visualization": {
    "type": "pose_skeleton",
    "skeleton": [
      [0, 1], [1, 2], [2, 3], [3, 4],
      [0, 5], [5, 6], [6, 7], [7, 8],
      [0, 9], [9, 10], [10, 11], [11, 12],
      [0, 13], [13, 14], [14, 15], [15, 16],
      [0, 17], [17, 18], [18, 19], [19, 20]
    ]
  },
  "parameters": [
    {
      "key": "keypoint_threshold",
      "label": "Keypoint Threshold",
      "type": "slider",
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "default": 0.0
    }
  ],
  "supported_modes": [
    "camera",
    "image"
  ]
}